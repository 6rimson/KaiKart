+      Log.info("upload probe totals, cache clean {}: all ok {}, staging bad {}, copy bad {}, wiped later {}, other {}",
+               cleaned != 0, c[7], c[0] + c[1] + c[2] + c[3], c[4] + c[5], c[6], 0);
+    }
+    for (const auto& [block, counts] : s_hbxBlocks) {
+      Log.info("upload probe block: memory {:x} offset {} MiB type {}: ok {} bad {}", block[0], block[1] * 8, block[2],
+               counts[0], counts[1]);
+    }
+  }
+  s_hbxProbes.clear();
+}
+#endif
