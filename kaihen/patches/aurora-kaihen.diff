+// AURORA_HBX_PROBE=1: follows one uploaded texture row per frame through the pipeline. It reads the
+// row from the staging buffer as the GPU sees it, from the texture right after the copy, and from
+// the texture again after the frame, which shows where an empty texture loses its data.
+struct HbxProbe {
+  wgpu::Buffer source;
+  wgpu::Buffer dest;
+  wgpu::Texture texture;
+  std::array<uint8_t, 256> expected{};
+  uint32_t bytes = 0;
+  uint32_t row = 0;
+  uint32_t width = 0;
+  uint32_t height = 0;
+  bool cleaned = false;
+  std::array<uint64_t, 3> image{};
+};
+
+std::mutex s_hbxImagesMutex;
+std::unordered_map<WGPUTexture, std::array<uint64_t, 3>> s_hbxImages;
+std::map<std::array<uint64_t, 3>, std::array<uint64_t, 2>> s_hbxBlocks;
+
+std::vector<HbxProbe> s_hbxProbes;
+uint64_t s_hbxProbeLastFrame = UINT64_MAX;
+uint32_t s_hbxProbeTotal = 0;
+uint64_t s_hbxProbeCounts[2][8]{};
+
+bool hbx_probe_enabled() noexcept {
+  static const bool enabled = std::getenv("AURORA_HBX_PROBE") != nullptr;
+  return enabled;
+}
+
+wgpu::Buffer hbx_probe_buffer() {
+  const wgpu::BufferDescriptor descriptor{.label = "HBX upload probe",
+                                          .usage = wgpu::BufferUsage::MapRead | wgpu::BufferUsage::CopyDst,
+                                          .size = 256};
+  return webgpu::g_device.CreateBuffer(&descriptor);
+}
+
+bool hbx_probe_matches(const wgpu::Buffer& buffer, const HbxProbe& probe) {
+  bool ok = false;
+  const auto future = buffer.MapAsync(wgpu::MapMode::Read, 0, 256, wgpu::CallbackMode::WaitAnyOnly,
+                                      [&ok](wgpu::MapAsyncStatus status, wgpu::StringView) {
+                                        ok = status == wgpu::MapAsyncStatus::Success;
+                                      });
+  if (webgpu::g_instance.WaitAny(future, 5000000000) != wgpu::WaitStatus::Success || !ok) {
+    return false;
+  }
+  const bool same = std::memcmp(buffer.GetConstMappedRange(0, 256), probe.expected.data(), probe.bytes) == 0;
+  buffer.Unmap();
+  return same;
+}
+
+void hbx_probe_copy_row(wgpu::CommandEncoder& cmd, const HbxProbe& probe, const wgpu::Buffer& target) {
+  const wgpu::TexelCopyTextureInfo source{.texture = probe.texture, .origin = {.x = 0, .y = probe.row, .z = 0}};
+  const wgpu::TexelCopyBufferInfo destination{.layout = {.bytesPerRow = 256, .rowsPerImage = 1}, .buffer = target};
+  const wgpu::Extent3D extent{probe.bytes / 4, 1, 1};
+  cmd.CopyTextureToBuffer(&source, &destination, &extent);
+}
+
+void hbx_probe_upload(wgpu::CommandEncoder& cmd, FramePacket& frame, const TextureUpload& item, uint64_t stagingOffset) {
+  if (!hbx_probe_enabled() || item.buffer || item.tex.mipLevel != 0 || frame.frameId == s_hbxProbeLastFrame ||
+      s_hbxProbeTotal >= 1500 || item.tex.texture.GetFormat() != wgpu::TextureFormat::RGBA8Unorm) {
+    return;
+  }
+  const uint32_t bytesPerRow = item.layout.bytesPerRow;
+  const uint32_t rows = item.size.height;
+  const uint32_t alignedRow = AURORA_ALIGN(bytesPerRow, 256);
+  const uint32_t bytes = std::min<uint32_t>(bytesPerRow, 256) & ~3u;
+  const uint8_t* cpu = frame.textureUpload.data() + item.layout.offset;
+  for (const uint32_t row : {rows / 2, rows / 4, rows * 3 / 4, 0u, rows - 1}) {
+    const uint8_t* line = cpu + uint64_t{row} * alignedRow;
+    if (bytes == 0 || std::all_of(line, line + bytes, [](uint8_t value) { return value == 0; })) {
+      continue;
+    }
+    static const char* clean = std::getenv("AURORA_HBX_CACHE_CLEAN");
+    HbxProbe probe{.source = hbx_probe_buffer(),
+                   .dest = hbx_probe_buffer(),
+                   .texture = item.tex.texture,
+                   .bytes = bytes,
+                   .row = row,
+                   .width = item.size.width,
+                   .height = rows,
+                   .cleaned = clean != nullptr && (clean[0] != '2' || (frame.frameId & 1) != 0)};
+    std::memcpy(probe.expected.data(), line, bytes);
+    {
+      std::lock_guard lock{s_hbxImagesMutex};
+      if (const auto it = s_hbxImages.find(item.tex.texture.Get()); it != s_hbxImages.end()) {
