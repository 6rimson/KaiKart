+#include "SDL_internal.h"
+
+// Nintendo Switch homebrew (kaiHEN, libounce): paths on the microSD, after the 3DS version.
+// File operations (and the current directory) are the POSIX ones.
+
+#include "../SDL_sysfilesystem.h"
+
+#include <errno.h>
+#include <sys/stat.h>
+
+char *SDL_SYS_GetBasePath(void)
+{
+    return SDL_strdup("sdmc:/switch/");
+}
+
+char *SDL_SYS_GetExeName(void)
+{
+    return NULL;
+}
+
+char *SDL_SYS_GetPrefPath(const char *org, const char *app)
+{
+    char *pref_path = NULL;
+    if (SDL_asprintf(&pref_path, "sdmc:/switch/%s/", app ? app : (org ? org : "SDL")) < 0) {
+        return NULL;
+    }
+    if (mkdir(pref_path, 0777) == -1 && errno != EEXIST) {
+        SDL_SetError("Failed to create '%s' (%s)", pref_path, strerror(errno));
+        SDL_free(pref_path);
+        return NULL;
+    }
+    return pref_path;
+}
+
+char *SDL_SYS_GetUserFolder(SDL_Folder folder)
+{
+    (void)folder;
+    SDL_Unsupported();
+    return NULL;
+}
