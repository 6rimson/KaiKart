diff --git sdl3-orig/src/audio/kaihen/SDL_kaihenaudio.c sdl3/src/audio/kaihen/SDL_kaihenaudio.c
new file mode 100644
index 000000000..be230fc41
--- /dev/null
+++ sdl3/src/audio/kaihen/SDL_kaihenaudio.c
@@ -0,0 +1,182 @@
+/*
+  SDL audio driver for kaiHEN (Switch 2 homebrew on libounce).
+
+  Plays through libnx's audout: 48 kHz, stereo, signed 16-bit, four buffers of 1024 frames in
+  page-aligned memory (audout's requirement). SDL converts any other format.
+*/
+#include "SDL_internal.h"
+
+#ifdef SDL_AUDIO_DRIVER_KAIHEN
+
+#include "../SDL_sysaudio.h"
+#include <switch.h>
+
+#define KAIHEN_AUDIO_BUFFERS 4
+#define KAIHEN_AUDIO_FRAMES 1024
+#define KAIHEN_AUDIO_BUFFER_BYTES (KAIHEN_AUDIO_FRAMES * 4)
+
+struct SDL_PrivateAudioData
+{
+    AudioOutBuffer buffers[KAIHEN_AUDIO_BUFFERS];
+    Uint8 *pcm;
+    bool busy[KAIHEN_AUDIO_BUFFERS];
+    int queued;
+    int current;
+    bool started;
+    bool opened;
+};
+
+static void KAIHENAUDIO_Reclaim(SDL_AudioDevice *device)
+{
+    struct SDL_PrivateAudioData *h = device->hidden;
+    int guard;
+    for (guard = 0; guard <= KAIHEN_AUDIO_BUFFERS; guard++) {
+        AudioOutBuffer *released = NULL;
+        u32 count = 0;
+        int i;
+        if (R_FAILED(audoutGetReleasedAudioOutBuffer(&released, &count)) || count == 0 || !released) {
+            return;
+        }
+        for (i = 0; i < KAIHEN_AUDIO_BUFFERS; i++) {
+            if (released == &h->buffers[i] && h->busy[i]) {
+                h->busy[i] = false;
+                h->queued--;
+                break;
+            }
+        }
+    }
+}
+
+static int KAIHENAUDIO_FreeSlot(SDL_AudioDevice *device)
+{
+    int i;
+    for (i = 0; i < KAIHEN_AUDIO_BUFFERS; i++) {
+        if (!device->hidden->busy[i]) {
+            return i;
+        }
+    }
+    return -1;
+}
+
+static bool KAIHENAUDIO_WaitDevice(SDL_AudioDevice *device)
+{
+    while (!SDL_GetAtomicInt(&device->shutdown)) {
+        KAIHENAUDIO_Reclaim(device);
+        if (KAIHENAUDIO_FreeSlot(device) >= 0) {
+            return true;
+        }
+        SDL_Delay(2);
+    }
+    return true;
+}
+
+static Uint8 *KAIHENAUDIO_GetDeviceBuf(SDL_AudioDevice *device, int *buffer_size)
+{
+    struct SDL_PrivateAudioData *h = device->hidden;
+    h->current = KAIHENAUDIO_FreeSlot(device);
+    if (h->current < 0) {
+        h->current = 0; // WaitDevice guarantees a slot; stay defensive
+    }
+    *buffer_size = KAIHEN_AUDIO_BUFFER_BYTES;
+    return h->pcm + h->current * KAIHEN_AUDIO_BUFFER_BYTES;
+}
+
+static bool KAIHENAUDIO_PlayDevice(SDL_AudioDevice *device, const Uint8 *buffer, int buflen)
+{
+    struct SDL_PrivateAudioData *h = device->hidden;
+    AudioOutBuffer *out;
+    int i = h->current;
+    if (i < 0 || h->busy[i]) {
+        return true;
+    }
+    out = &h->buffers[i];
+    SDL_memset(out, 0, sizeof(*out));
+    out->buffer = h->pcm + i * KAIHEN_AUDIO_BUFFER_BYTES;
+    out->buffer_size = KAIHEN_AUDIO_BUFFER_BYTES;
+    out->data_size = (u64)buflen;
+    if (R_FAILED(audoutAppendAudioOutBuffer(out))) {
+        return true; // dropped; keep the stream alive
+    }
+    h->busy[i] = true;
+    h->queued++;
+    if (!h->started && h->queued >= 2 && R_SUCCEEDED(audoutStartAudioOut())) {
+        h->started = true;
+    }
+    return true;
+}
+
+static void KAIHENAUDIO_CloseDevice(SDL_AudioDevice *device)
+{
+    struct SDL_PrivateAudioData *h = device->hidden;
+    int tries;
+    if (!h) {
+        return;
+    }
+    if (h->opened) {
+        if (h->started) {
+            audoutStopAudioOut();
+        }
+        for (tries = 0; tries < 40 && h->queued > 0; tries++) {
+            KAIHENAUDIO_Reclaim(device);
+            if (h->queued > 0) {
+                SDL_Delay(1);
+            }
+        }
+        audoutExit();
+    }
+    SDL_aligned_free(h->pcm);
+    SDL_free(h);
+    device->hidden = NULL;
+}
+
+static bool KAIHENAUDIO_OpenDevice(SDL_AudioDevice *device)
+{
+    struct SDL_PrivateAudioData *h;
+    Result rc;
+
+    if (device->recording) {
+        return SDL_SetError("kaihen: recording is not supported");
+    }
+    h = (struct SDL_PrivateAudioData *)SDL_calloc(1, sizeof(*h));
+    if (!h) {
+        return false;
+    }
+    device->hidden = h;
+    h->pcm = (Uint8 *)SDL_aligned_alloc(0x1000, KAIHEN_AUDIO_BUFFERS * KAIHEN_AUDIO_BUFFER_BYTES);
+    if (!h->pcm) {
+        return false;
+    }
+    SDL_memset(h->pcm, 0, KAIHEN_AUDIO_BUFFERS * KAIHEN_AUDIO_BUFFER_BYTES);
+    rc = audoutInitialize();
+    if (R_FAILED(rc)) {
+        return SDL_SetError("kaihen: audoutInitialize failed (0x%x)", (unsigned)rc);
+    }
+    h->opened = true;
+    if (audoutGetSampleRate() != 48000 || audoutGetChannelCount() != 2 || audoutGetPcmFormat() != PcmFormat_Int16) {
+        return SDL_SetError("kaihen: audout is not 48 kHz stereo s16");
+    }
+
+    device->spec.format = SDL_AUDIO_S16LE;
+    device->spec.channels = 2;
+    device->spec.freq = 48000;
+    device->sample_frames = KAIHEN_AUDIO_FRAMES;
+    SDL_UpdatedAudioDeviceFormat(device);
+    return true;
+}
+
+static bool KAIHENAUDIO_Init(SDL_AudioDriverImpl *impl)
+{
+    impl->OpenDevice = KAIHENAUDIO_OpenDevice;
+    impl->CloseDevice = KAIHENAUDIO_CloseDevice;
+    impl->WaitDevice = KAIHENAUDIO_WaitDevice;
+    impl->GetDeviceBuf = KAIHENAUDIO_GetDeviceBuf;
+    impl->PlayDevice = KAIHENAUDIO_PlayDevice;
+    impl->OnlyHasDefaultPlaybackDevice = true;
+    return true;
+}
+
+AudioBootStrap KAIHENAUDIO_bootstrap = {
+    "kaihen", "kaiHEN audout", KAIHENAUDIO_Init, false, false
+};
+
+#endif // SDL_AUDIO_DRIVER_KAIHEN
