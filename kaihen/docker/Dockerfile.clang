# The kaiHEN build with Clang (kaihen/run.sh, KAIHEN_COMPILER=clang): the HBLauncher build image
# (Ubuntu, Clang 22, llvm-profdata for the shipped PGO profiles) with the Switch 2 devkit copied in
# from its own image. Clang compiles; the devkit's GCC links, with newlib, libounce and OunceVK.
#   docker build -f kaihen/docker/Dockerfile.clang --build-arg HBX_IMAGE=wiicompiled-hbx-build:<tag> \
#     -t ounce-devkit-clang kaihen/docker
ARG HBX_IMAGE
FROM ounce-devkit AS devkit
FROM ${HBX_IMAGE}
COPY --from=devkit /opt/devkitpro /opt/devkitpro
ENV DEVKITPRO=/opt/devkitpro DEVKITARM=/opt/devkitpro/devkitARM PATH=/opt/devkitpro/tools/bin:$PATH
