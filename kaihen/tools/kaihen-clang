#!/bin/bash
# clang for the kaiHEN build (kaihen/cmake/kaihen.cmake): the devkit's flags include GCC's -mtp=soft,
# which Clang rejects (Clang reads TPIDR_EL0, which the shim fills with libnx's thread pointer).
# The translated game code is compiled -fPIE instead of the devkit's -fPIC: -fPIC is for shared
# libraries (every global and call assumed replaceable at load time), and that code is the hot path.
# Everything else keeps -fPIC: with -fPIE throughout, the game crashed once its GPU device was up.
pie=0
# A target's precompiled header must match its sources: the translated targets' headers are -fPIE
# too (only mkw_base_shared has one today).
case "$*" in
  *build_shards*|*retro_rewind_full_cpp*|*/generated/*|*mkw_base_*.dir/cmake_pch*|*mkw_retro_*.dir/cmake_pch*) pie=1 ;;
esac
args=()
for arg in "$@"; do
  case "$arg" in
    -mtp=soft) ;;
    -fPIC) if (( pie )); then args+=(-fPIE); else args+=(-fPIC); fi ;;
    *) args+=("$arg") ;;
  esac
done
exec clang "${args[@]}"
