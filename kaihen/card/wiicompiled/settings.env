# Settings read at launch (KEY=VALUE; # starts a comment).
# Clocks: set in the port menu (L + R + right stick click), which saves them here. A rate in MHz,
# max, or 0 for the system's own. Memory and GPU run as chosen only on a charger: on battery the
# console halves the CPU when they run above its rates. The CPU keeps its rate either way.
KAIHEN_CPU_MHZ=1702
KAIHEN_MEMORY_MHZ=0
KAIHEN_GPU_MHZ=0
# MKW_PERF_STATS=1 logs FPS and frame timing to UserData/Logs/kaihen.log once a second
# KAIHEN_PROFILE=1 samples the game thread during races into UserData/Logs/profile.bin
# (KAIHEN_PROFILE=load: only frames that take over 200 ms, such as a race's load)
